{
  "redirects": [
    {
      "source": "/terms",
      "destination": "/terms-condition",
      "permanent": true
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/terms-condition",
      "permanent": true
    },
    {
      "source": "/returns",
      "destination": "/return-policy",
      "permanent": true
    },
    {
      "source": "/refund-policy",
      "destination": "/return-policy",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}